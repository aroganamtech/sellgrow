{
  "base_model": "Qwen/Qwen2.5-VL-7B-Instruct",
  "lora_config": {
    "r": 16,
    "lora_alpha": 32,
    "target_modules": [
      "q_proj",
      "v_proj",
      "k_proj",
      "o_proj",
      "gate_proj",
      "up_proj",
      "down_proj"
    ],
    "lora_dropout": 0.05,
    "bias": "none",
    "task_type": "CAUSAL_LM"
  },
  "training_args": {
    "per_device_train_batch_size": 2,
    "gradient_accumulation_steps": 4,
    "warmup_steps": 20,
    "max_steps": 200,
    "learning_rate": 0.0002,
    "fp16": true,
    "logging_steps": 10,
    "output_dir": "./checkpoints",
    "save_strategy": "steps",
    "save_steps": 50,
    "optim": "paged_adamw_8bit"
  },
  "dataset_file": "brochure_dataset.json"
}