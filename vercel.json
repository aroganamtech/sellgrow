{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    },
    {
      "src": "backend/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/detect-region",
      "dest": "backend/main.py"
    },
    {
      "src": "/api/db-health",
      "dest": "backend/main.py"
    },
    {
      "src": "/api/py/(.*)",
      "dest": "backend/main.py"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
