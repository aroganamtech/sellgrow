# Hostinger Apache Configuration for SellGrow Application
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS on Hostinger
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Map _next asset requests to unblocked next folder
  RewriteRule ^_next/(.*)$ next/$1 [L,QSA]

  # 3. Serve existing static files & directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. Map clean URL requests to corresponding .html files
  # /pricing -> pricing.html
  # /sg-superadmin -> sg-superadmin.html
  # /sg-superadmin/admin-growth -> sg-superadmin/admin-growth.html
  # /sg-admin/operator -> sg-admin/operator.html
  # /login -> login.html
  # /register -> register.html
  # /dashboard -> dashboard.html
  # /about -> about.html
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # 5. Fallback all SPA routes to /index.html
  RewriteRule ^(.*)$ /index.html [L]
</IfModule>

# Enable CORS and Prevent Stale Caching on Hostinger
<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"

  # Disable HTML caching so Hostinger and browsers always fetch the updated build
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Cache static assets (JS, CSS, images) with long max-age
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
