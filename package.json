{
  "name": "sellgrow",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 11223",
    "clean": "node -e \"const fs=require('fs'); ['out','.next_build','.next'].forEach(d => { if(fs.existsSync(d)) try{fs.rmSync(d,{recursive:true,force:true})}catch(e){} });\"",
    "build": "next build",
    "postbuild": "node scripts/export-out-folder.js",
    "build:clean": "npm run clean && npm run build",
    "start": "next start -p 11223",
    "lint": "next lint",
    "db:init": "node database/init_db.js",
    "db:test": "node database/test_connection.js",
    "train": "python brochure_ai_model/train_pdf_folder.py --epochs 10",
    "train:auto": "python brochure_ai_model/auto_train_upcoming_pdfs.py --epochs 10",
    "train:corpus": "python brochure_ai_model/dataset_corpus_trainer.py"
  },
  "dependencies": {
    "framer-motion": "^11.1.7",
    "lenis": "^1.3.25",
    "lucide-react": "^0.378.0",
    "mongodb": "^6.5.0",
    "mysql2": "^3.24.2",
    "next": "^16.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sarvamai": "^1.1.8-alpha.5"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5"
  }
}
